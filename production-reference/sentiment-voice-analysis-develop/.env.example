## APPLICATION CONFIGURATION
ENVIRONMENT=""                          # Environment name (e.g., nprd, prod)

## VERINT SITE INTEGRATION (SharePoint Voice Files)
VERINT_SITE_NAME=""                     # SharePoint site name
VERINT_SITE_CLIENT_ID=""                # Azure AD app client ID
VERINT_SITE_CLIENT_SECRET=""            # Azure AD app client secret
VERINT_SITE_TENANT_ID=""               # Azure AD tenant ID
VERINT_SITE_SITE_DOMAIN=""             # SharePoint domain (e.g., company.sharepoint.com)
VERINT_SITE_SITE_PATH=""               # SharePoint site path (e.g., /sites/Verint)

## CONTROL SITE INTEGRATION (SharePoint Prompts & Tracking)
CONTROL_SITE_NAME=""                    # Control SharePoint site name
CONTROL_SITE_CLIENT_ID=""              # Azure AD app client ID
CONTROL_SITE_CLIENT_SECRET=""          # Azure AD app client secret
CONTROL_SITE_TENANT_ID=""              # Azure AD tenant ID
CONTROL_SITE_SITE_DOMAIN=""            # SharePoint domain
CONTROL_SITE_SITE_PATH=""              # SharePoint site path
GEMINI_COST_PATH=""                     # Path to store Gemini cost logs

## TAX INVOICE INTEGRATION (SharePoint Tax Invoices Document Files)
TAX_INVOICE_SITE_NAME=""                     # SharePoint site name for tax invoice integration
TAX_INVOICE_SITE_CLIENT_ID=""                            # Azure AD app client ID for tax invoice integration
TAX_INVOICE_SITE_CLIENT_SECRET=""                        # Azure AD app client secret for tax invoice integration
TAX_INVOICE_SITE_TENANT_ID=""                        # Azure AD tenant ID for tax invoice integration
TAX_INVOICE_SITE_SITE_DOMAIN=""                    # SharePoint domain for tax invoice integration
TAX_INVOICE_SITE_SITE_PATH=""                    # SharePoint site path for tax invoice integration
TAX_INVOICE_TAX_INVOICE_OUTPUT=""                # SharePoint Level-2 folder for reconcile Output workbooks (under ROOT)
TAX_INVOICE_TAX_INVOICE_ARCHIVE_INV=""           # SharePoint Level-2 folder for archived source invoices (under ROOT)
TAX_INVOICE_TAX_INVOICE_ARCHIVE_VAT=""           # SharePoint Level-2 folder for the archived Z45 report (under ROOT)
TAX_INVOICE_TAX_INVOICE_REJECTED=""              # SharePoint Level-2 folder for rejected pages/files, e.g. Achieve_Reject (under ROOT)
TAX_INVOICE_CONTROL_ROOT=""                      # SharePoint control-site root for tax-invoice logs/results
TAX_INVOICE_TRANSACTION_LOG_PATH=""              # Control Level-2 folder for monthly transaction_log_YYYYMM.csv
TAX_INVOICE_PERFORMANCE_LOG_PATH=""              # Control Level-2 folder for monthly performance_log_YYYYMM.csv
TAX_INVOICE_OCR_TRACING_LOG_PATH=""              # Control Level-2 folder for the raw-Gemini tracing_log.csv (append-only, 90-day retention)
TAX_INVOICE_FACT_CHECK_PATH=""                        # Control Level-2 folder for the fact-check reference set (source_file/, ground_truth_file/, master_file/, logs)
TAX_INVOICE_SYSTEM_PROMPT_PATH=""                     # Control Level-2 folder holding system_prompt.md (OCR Gemini system prompt, downloaded at submit time)
TAX_INVOICE_LOG_RETENTION_DAYS="90"              # Retention window (days) for ALL tax-invoice logs; -1 disables retention. Unset -> 90

## MICROSOFT GRAPH EMAIL NOTIFICATIONS (sender mailbox + recipients)
SANDBOX_SITE_NAME=""                     # Sandbox SharePoint site name (msgraph sender tenant)
SANDBOX_SITE_CLIENT_ID=""                # Azure AD app client ID for Microsoft Graph sendMail
SANDBOX_SITE_CLIENT_SECRET=""            # Azure AD app client secret for Microsoft Graph sendMail
SANDBOX_SITE_TENANT_ID=""                # Azure AD tenant ID for Microsoft Graph sendMail
SANDBOX_SITE_SITE_DOMAIN=""              # Sandbox SharePoint domain
SANDBOX_SITE_SITE_PATH=""                # Sandbox SharePoint site path
BOT_EMAIL=""                             # Sender mailbox (licensed UPN) for automated emails
USER_EMAIL=""                            # Primary recipient(s); comma-separated for multiple
OPER_EMAIL=""                            # Operations recipient(s)
DEV_EMAIL=""                             # Developer CC recipient(s)

## LOGGING
LOG_LEVEL=""                            # Logging level (DEBUG, INFO, WARNING, ERROR)
