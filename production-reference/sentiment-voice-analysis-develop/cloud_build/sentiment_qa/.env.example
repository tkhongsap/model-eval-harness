## APPLICATION CONFIGURATION
ENVIRONMENT=""                          # Environment name (e.g., nprd, prod)
QA_GCP_PROJECT_ID=""                    # GCP project ID
QA_GCP_PROJECT_NAME=""                  # GCP project display name
QA_VERTEX_AI_MODEL_NAME=""              # Vertex AI model (e.g., gemini-2.5-flash)
QA_VERTEX_AI_LOCATION=""                # Vertex AI region (e.g., asia-southeast1)
QA_PROCESSING_BUCKET=""                 # GCS bucket for batch processing

## VERINT SITE INTEGRATION (SharePoint Voice Files)
VERINT_SITE_NAME=""                     # SharePoint site name
VERINT_SITE_CLIENT_ID=""                # Azure AD app client ID
VERINT_SITE_CLIENT_SECRET=""            # Azure AD app client secret
VERINT_SITE_TENANT_ID=""               # Azure AD tenant ID
VERINT_SITE_SITE_DOMAIN=""             # SharePoint domain (e.g., company.sharepoint.com)
VERINT_SITE_SITE_PATH=""               # SharePoint site path (e.g., /sites/Verint)
QA_VERINT_ROOT=""                       # Root folder for voice files
QA_VERINT_PRODUCTS=""                   # Product-list token substituted into per-product voice paths
QA_VERINT_PRODUCTS_INBOUND=""           # Inbound product list
QA_VERINT_PRODUCTS_OUTBOUND=""          # Outbound product list
QA_VERINT_OUTPUT=""                     # Output folder path

## CONTROL SITE INTEGRATION (SharePoint Prompts & Tracking)
CONTROL_SITE_NAME=""                    # Control SharePoint site name
CONTROL_SITE_CLIENT_ID=""              # Azure AD app client ID
CONTROL_SITE_CLIENT_SECRET=""          # Azure AD app client secret
CONTROL_SITE_TENANT_ID=""              # Azure AD tenant ID
CONTROL_SITE_SITE_DOMAIN=""            # SharePoint domain
CONTROL_SITE_SITE_PATH=""              # SharePoint site path
GEMINI_COST_PATH=""                     # Path to store Gemini cost logs
QA_CONTROL_ROOT=""                      # Control root folder
QA_CONTROL_FILE_PATH=""                 # Control log file path
QA_USER_PROMPT_PATH=""                  # User prompt file path
QA_TRANSACTION_LOG_PATH=""              # Transaction log path
QA_PERFORMANCE_LOG_PATH=""              # Performance log path
QA_BATCH_PROCESSING_LOG_PATH=""         # Batch processing log path
QA_FACT_CHECK_PATH=""                   # Fact check path
QA_FACT_CHECK_PRODUCTS=""               # Fact-check product list
QA_USER_PLAYGROUND_PATH=""              # User-playground SharePoint root (input/output/archive)

## MICROSOFT GRAPH EMAIL NOTIFICATIONS (sender mailbox + recipients)
SANDBOX_SITE_NAME=""                     # Sandbox SharePoint site name (msgraph sender tenant)
SANDBOX_SITE_CLIENT_ID=""                # Azure AD app client ID for Microsoft Graph sendMail
SANDBOX_SITE_CLIENT_SECRET=""            # Azure AD app client secret for Microsoft Graph sendMail
SANDBOX_SITE_TENANT_ID=""                # Azure AD tenant ID for Microsoft Graph sendMail
SANDBOX_SITE_SITE_DOMAIN=""              # Sandbox SharePoint domain
SANDBOX_SITE_SITE_PATH=""                # Sandbox SharePoint site path
BOT_EMAIL=""                             # Sender mailbox (licensed UPN) for automated emails
USER_EMAIL=""                            # Primary recipient(s); comma-separated for multiple
OPER_EMAIL=""                            # Operations recipient(s)
DEV_EMAIL=""                             # Developer CC recipient(s)

## PERFORMANCE SETTINGS
QA_LOOKBACK_DAYS=0                     # Days to look back for input files
QA_BATCH_SIZE=0                       # Max records per batch job
QA_MAX_CONCURRENT_UPLOADS=0           # Concurrent SharePoint→GCS uploads

## LOGGING
LOG_LEVEL=""                            # Logging level (DEBUG, INFO, WARNING, ERROR)
