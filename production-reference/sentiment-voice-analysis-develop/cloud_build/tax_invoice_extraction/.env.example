# Mirrors the env vars injected into the Cloud Run job by
# terraform/projects/tax_invoice_extraction (locals.tf / main.tf). Copy to .env for local dev.

## APPLICATION CONFIGURATION
ENVIRONMENT=""                              # Environment name (nprd, release, prod); also the GCS bucket-name prefix
TAX_INVOICE_GCP_PROJECT_ID=""               # GCP project ID
TAX_INVOICE_GCP_PROJECT_NAME=""             # GCP project display name
TAX_INVOICE_VERTEX_AI_MODEL_NAME=""         # Vertex AI model (e.g., gemini-2.5-flash)
TAX_INVOICE_VERTEX_AI_LOCATION=""           # Vertex AI region (e.g., asia-southeast1)
TAX_INVOICE_PROCESSING_BUCKET=""            # GCS bucket (suffix) for OCR batch processing

## TAX INVOICE SITE INTEGRATION (SharePoint source documents + reconcile output)
TAX_INVOICE_SITE_NAME=""                     # SharePoint site name
TAX_INVOICE_SITE_CLIENT_ID=""                # Azure AD app client ID
TAX_INVOICE_SITE_CLIENT_SECRET=""            # Azure AD app client secret
TAX_INVOICE_SITE_TENANT_ID=""                # Azure AD tenant ID
TAX_INVOICE_SITE_SITE_DOMAIN=""              # SharePoint domain (e.g., company.sharepoint.com)
TAX_INVOICE_SITE_SITE_PATH=""                # SharePoint site path (e.g., /sites/TaxInvoice)
TAX_INVOICE_TAX_INVOICE_ROOT=""              # Root folder for tax-invoice documents
TAX_INVOICE_TAX_INVOICE_INPUT=""             # Source-document input folder (under ROOT)
TAX_INVOICE_TAX_INVOICE_OUTPUT=""            # Reconcile per-document Output workbooks folder (under ROOT)
TAX_INVOICE_TAX_INVOICE_ARCHIVE_INV=""       # Archived source invoices folder (under ROOT)
TAX_INVOICE_TAX_INVOICE_ARCHIVE_VAT=""       # Archived Z45 report folder (under ROOT)
TAX_INVOICE_TAX_INVOICE_REJECTED=""          # Rejected pages/files folder (under ROOT)
TAX_INVOICE_TAX_INVOICE_MASTER_BUYERS=""     # Master Buyer Company workbook folder (under ROOT)
TAX_INVOICE_TAX_INVOICE_MASTER_VENDORS=""    # Master Vendor Company workbook folder (under ROOT)
TAX_INVOICE_TAX_INVOICE_Z45_REPORT=""        # Z45 (ZAPRPT45) report folder (under ROOT)

## CONTROL SITE INTEGRATION (SharePoint logs, results, Gemini cost)
CONTROL_SITE_NAME=""                          # Control SharePoint site name
CONTROL_SITE_CLIENT_ID=""                     # Azure AD app client ID
CONTROL_SITE_CLIENT_SECRET=""                 # Azure AD app client secret
CONTROL_SITE_TENANT_ID=""                     # Azure AD tenant ID
CONTROL_SITE_SITE_DOMAIN=""                   # SharePoint domain
CONTROL_SITE_SITE_PATH=""                     # SharePoint site path
GEMINI_COST_PATH=""                           # Path to store Gemini cost logs
TAX_INVOICE_CONTROL_ROOT=""                   # Control-site root for tax-invoice logs/results
TAX_INVOICE_CONTROL_EXTRACTION_PATH=""        # Control folder for extraction_result_YYYY-MM-DD.csv
TAX_INVOICE_TRANSACTION_LOG_PATH=""           # Control folder for transaction_log_YYYYMM.csv
TAX_INVOICE_PERFORMANCE_LOG_PATH=""           # Control folder for performance_log_YYYYMM.csv
TAX_INVOICE_PAGE_MANIFEST_LOG_PATH=""         # Control folder for the page-manifest CSV
TAX_INVOICE_OCR_PREP_LOG_PATH=""              # Control folder for the OCR pre-processing log CSV
TAX_INVOICE_OCR_TRACING_LOG_PATH=""           # Control folder for the raw-Gemini tracing_log_YYYYMM.csv
TAX_INVOICE_FACT_CHECK_PATH=""                # Control folder for the fact-check reference set (source_file/, ground_truth_file/, master_file/, logs)
TAX_INVOICE_SYSTEM_PROMPT_PATH=""             # Control folder holding system_prompt.md (OCR Gemini system prompt, downloaded at submit time)

## PERFORMANCE SETTINGS
TAX_INVOICE_MAX_CONCURRENT_UPLOADS=0          # Concurrent SharePoint→GCS uploads
TAX_INVOICE_LOG_RETENTION_DAYS=90             # Retention window (days) for ALL tax-invoice logs (pre-processing,
                                              # page-manifest, tracing, transaction, performance). -1 disables
                                              # retention entirely. Unset/invalid -> 90. Aged in-flight rows are
                                              # pruned too (stuck-file backstop); keep well above job runtime.

## MICROSOFT GRAPH EMAIL NOTIFICATIONS (sender mailbox + recipients)
SANDBOX_SITE_CLIENT_ID=""                     # Azure AD app client ID for Microsoft Graph sendMail
SANDBOX_SITE_CLIENT_SECRET=""                 # Azure AD app client secret for Microsoft Graph sendMail
SANDBOX_SITE_TENANT_ID=""                     # Azure AD tenant ID for Microsoft Graph sendMail
BOT_EMAIL=""                                  # Sender mailbox (licensed UPN) for automated emails
DEVELOPER_EMAIL=""                            # Developer CC recipient(s) — stored in the DEVELOPER_EMAIL secret
USER_EMAIL=""                                 # Primary recipient(s); comma-separated for multiple
OPER_EMAIL=""                                 # Operations recipient(s)

## LOGGING
LOG_LEVEL=""                                  # Logging level (DEBUG, INFO, WARNING, ERROR)
