# Copy to .env and fill in the real key. .env is gitignored; .env.example is not.
#
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model IDs verified live against https://openrouter.ai/api/v1/models on 2026-08-04.
# These are the CLOSEST REAL matches to the models named in the eval plan, not exact
# matches -- OpenRouter's live catalog does not carry "Gemini 2.5 Flash",
# "Qwen3.6-27B", or any Gemma model as of this date. See scripts/openrouter-smoketest/README.md.
OPENROUTER_MODEL_INCUMBENT=google/gemini-3.6-flash
OPENROUTER_MODEL_CANDIDATE=qwen/qwen3.7-flash
