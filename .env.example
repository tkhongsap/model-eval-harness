# Environment for scripts/openrouter-smoketest/ ONLY.
#
# The scoring library in src/evalharness/ needs NO API key and makes no model calls.
# Nothing here is required to run the test suite.
#
# WARNING: do NOT `cp .env.example .env` if you already have a .env. That overwrites
# it. Append the lines you need instead.
#
# .env is gitignored at any depth, so it may live here at the repo root or in
# scripts/openrouter-smoketest/. The script searches both, script-local first.

# --- OpenRouter -------------------------------------------------------------------
# Get a key at https://openrouter.ai/keys
# Any ONE of these names works. The script accepts all three, checked in this order:
#   OPENROUTER_API_KEY, OPEN_ROUTER_API, OPENROUTER_KEY
OPENROUTER_API_KEY=

# --- Models -----------------------------------------------------------------------
# Verified live against https://openrouter.ai/api/v1/models on 2026-08-04.
# These are the CLOSEST REAL matches to the models named in the eval plan, not exact
# ones: OpenRouter's catalog carries no "Gemini 2.5 Flash", no "Qwen3.6-27B", and no
# Gemma model of any generation. See scripts/openrouter-smoketest/README.md.
OPENROUTER_MODEL_INCUMBENT=google/gemini-3.6-flash
OPENROUTER_MODEL_CANDIDATE=qwen/qwen3.7-flash
