## APPLICATION CONFIGURATION
ENVIRONMENT=""                          # Environment name (e.g., nprd, prod)
TELESALE_GCP_PROJECT_ID=""              # GCP project ID
TELESALE_GCP_PROJECT_NAME=""            # GCP project display name
TELESALE_VERTEX_AI_MODEL_NAME=""        # Vertex AI model (e.g., gemini-2.5-flash)
TELESALE_VERTEX_AI_LOCATION=""          # Vertex AI region (e.g., asia-southeast1)
TELESALE_PROCESSING_BUCKET=""           # GCS bucket for batch processing

## VERINT SITE INTEGRATION (SharePoint Voice Files)
VERINT_SITE_NAME=""                     # SharePoint site name
VERINT_SITE_CLIENT_ID=""                # Azure AD app client ID
VERINT_SITE_CLIENT_SECRET=""            # Azure AD app client secret
VERINT_SITE_TENANT_ID=""               # Azure AD tenant ID
VERINT_SITE_SITE_DOMAIN=""             # SharePoint domain (e.g., company.sharepoint.com)
VERINT_SITE_SITE_PATH=""               # SharePoint site path (e.g., /sites/Verint)
TELESALE_VERINT_ROOT=""                 # Root folder for voice files
TELESALE_VERINT_INPUT=""                # Input folder path
TELESALE_VERINT_OUTPUT=""               # Output folder path
TELESALE_MASTER_PATH=""                 # Master data file path

## CONTROL SITE INTEGRATION (SharePoint Prompts & Tracking)
CONTROL_SITE_NAME=""                    # Control SharePoint site name
CONTROL_SITE_CLIENT_ID=""              # Azure AD app client ID
CONTROL_SITE_CLIENT_SECRET=""          # Azure AD app client secret
CONTROL_SITE_TENANT_ID=""              # Azure AD tenant ID
CONTROL_SITE_SITE_DOMAIN=""            # SharePoint domain
CONTROL_SITE_SITE_PATH=""              # SharePoint site path
GEMINI_COST_PATH=""                     # Path to store Gemini cost logs
TELESALE_CONTROL_ROOT=""                # Control root folder
TELESALE_CONTROL_FILE_PATH=""           # Control log file path
TELESALE_USER_PROMPT_PATH=""            # User prompt file path
TELESALE_TRANSACTION_LOG_PATH=""        # Transaction log path
TELESALE_PERFORMANCE_LOG_PATH=""        # Performance log path
TELESALE_BATCH_PROCESSING_LOG_PATH=""   # Batch processing log path
TELESALE_FACT_CHECK_PATH=""             # Fact check path

## PERFORMANCE SETTINGS
TELESALE_LOOKBACK_DAYS=0               # Days to look back for input files
TELESALE_BATCH_SIZE=0                  # Max records per batch job
TELESALE_MAX_CONCURRENT_UPLOADS=0      # Concurrent SharePoint→GCS uploads

## LOGGING
LOG_LEVEL=""                            # Logging level (DEBUG, INFO, WARNING, ERROR)